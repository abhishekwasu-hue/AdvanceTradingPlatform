# Phase AX: the public edge for one compose host (docker-compose.prod.yml). Caddy obtains and
# renews the certificates for {$DOMAIN} and www.{$DOMAIN} on its own; nothing to install or rotate by hand.
{
	email {$ACME_EMAIL}
}

# The www name only sends visitors to the apex (permanent, path and query kept). Its DNS may be an A record or a CNAME
# to the apex - either way it reaches this host, and Caddy gets www its own certificate over port 80 like the apex.
# Plain http://www... is first sent to https://www... by Caddy itself, then here.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Prometheus scrapes the API's /metrics from inside the host, never through the internet.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	handle /api/* {
		# P0.1 / S3: the API caps declared bodies itself (MAX_REQUEST_BODY_BYTES); the edge caps chunked ones too.
		request_body {
			max_size 8MB
		}
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# P0.3 / S6: same policy the frontend image sets (defence in depth at the edge).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

# OPS-SHARE (owner 5 Nov): other projects on this host (e.g. BagMitra) are served by this same Caddy. Each one is ONE
# file on the host in CADDY_SITES_DIR (default /etc/atp/caddy-sites, mounted read-only at /etc/caddy/sites), for example
# bagmitra.caddy holding its site block; this repository never carries another project's domain. A glob with no
# matching file only logs a warning, so a host without such files runs exactly as before. The other project's
# containers join the shared Docker network SHARED_EDGE_NETWORK (default `edge`) that Caddy is also on.
import /etc/caddy/sites/*.caddy
