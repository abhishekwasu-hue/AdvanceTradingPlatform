# Copy to .env (same directory as docker-compose.yml) and adjust before `docker compose up`.
# Never commit the real .env file.

POSTGRES_USER=atp_user
POSTGRES_PASSWORD=atp_dev_password
POSTGRES_DB=advance_trading_platform

# JWT signing secret. Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key encrypting broker credentials at rest. Leave unset only for local/dev - set (and
# keep stable, ideally via a secret manager) for anything real:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# P0.4: format for newly written secrets. "fernet" (default) is readable by every image since Phase N, so a
# rollback never strands a credential; set "aesgcm" (AES-256-GCM bound to tenant + column) once P0.4 has run
# for a day, then `python scripts/reencrypt_secrets.py reencrypt` to convert existing rows. Both are always read.
SECRETS_WRITE_FORMAT=fernet

# --- Phase G safety knobs (optional; defaults shown) ---------------------------------------
# Staleness gate: no signal when the newest base candle is more than this many bars behind the
# clock; no exit decision on a broker quote older than this many seconds (0 = off).
MARKET_DATA_MAX_STALE_BARS=3
QUOTE_MAX_STALE_SECONDS=120
# Phase S streaming quotes (Upstox Feed V3 / Kite ticker). Off: the worker polls REST once per
# symbol per cycle. On: ticks younger than TICK_MAX_AGE_SECONDS are used, REST otherwise.
STREAMING_QUOTES_ENABLED=false
TICK_MAX_AGE_SECONDS=120
# Trade port order-safety switches (off by default; LIVE behaviour unchanged until set).
# ORDER_MARKET_PROTECTION_PCT: 1-25 sends Upstox market_protection on MARKET / SL-M orders; empty = not sent.
ORDER_MARKET_PROTECTION_PCT=
# LIVE_STRICT_WING_FILL: true = a multi-leg entry sends its shorts only after every wing filled in full.
LIVE_STRICT_WING_FILL=false
# G-LIVE switches, all off until the operator decides (see docs/OPERATIONS.md "G-LIVE order switches"):
# LIVE_MARKET_PROTECTION: true = every Zerodha / Upstox MARKET and SL-M order carries market_protection
#   (ORDER_MARKET_PROTECTION_PCT when set, else -1 = the broker's automatic band).
LIVE_MARKET_PROTECTION=false
# LIVE_UPSTOX_OPTION_STOP_LIMIT: true = Upstox protective stops on options go as SL (stop-limit), not SL-M.
LIVE_UPSTOX_OPTION_STOP_LIMIT=false
# LIVE_EXIT_IF_NO_STOP: true = a LIVE position whose broker stop cannot be placed / re-armed is closed at once.
LIVE_EXIT_IF_NO_STOP=false
# STOP_LIMIT_BAND_PCT: how far past the trigger a stop-limit's limit sits (% of the trigger). 1.0 = today.
STOP_LIMIT_BAND_PCT=1.0
# BACKTEST_HOLDOUT_START: e.g. 2026-04-01 - the optimizer never uses bars from this date on; empty = no sealed holdout.
BACKTEST_HOLDOUT_START=
# Phase AU global cues for the Copilot (US futures, Asia, Brent, gold, dollar, USD/INR, US 10Y) from
# free public data (Yahoo Finance, Stooq fallback), delayed ~15 min, background only - never a
# trading input. Needs outbound internet from the backend and worker; false turns the fetch off.
GLOBAL_CUES_ENABLED=true
# Per-broker circuit breaker: over FAILURE_RATIO of broker calls failing (timeouts/5xx/429) within
# WINDOW_SECONDS, after at least MIN_CALLS, pauses new LIVE entries to that broker platform-wide
# for OPEN_SECONDS. Exits are never paused.
BROKER_CIRCUIT_WINDOW_SECONDS=60
BROKER_CIRCUIT_MIN_CALLS=5
BROKER_CIRCUIT_FAILURE_RATIO=0.5
BROKER_CIRCUIT_OPEN_SECONDS=120

# P0.3: token signing and sessions.
# Issuer/audience claims on access tokens; previous secrets (comma-separated) still verify during a rotation;
# JWT_ACCEPT_LEGACY accepts pre-P0.3 tokens (no iss/aud) - set false a day after the deploy.
JWT_ISSUER=atp
JWT_AUDIENCE=atp-web
JWT_PREVIOUS_SECRET_KEYS=
JWT_ACCEPT_LEGACY=true
# Refresh token cookie name; REFRESH_TOKEN_IN_BODY=false once every browser runs the P0.3 UI.
REFRESH_COOKIE_NAME=atp_refresh
REFRESH_TOKEN_IN_BODY=true

# P0.2: login protection and outbound URLs.
# Proxies whose X-Forwarded-For uvicorn trusts (the prod overlay sets "*": only Caddy reaches backend:8000).
FORWARDED_ALLOW_IPS=127.0.0.1
# redis = count request limits in Redis across replicas (automatic in production/staging); empty = in-process.
RATE_LIMIT_BACKEND=
# Progressive login delay after N failures per email (2^(n-N) s, capped); CAPTCHA after M failures when a provider is set.
LOGIN_DELAY_AFTER_FAILURES=3
LOGIN_DELAY_MAX_SECONDS=60
LOGIN_CAPTCHA_AFTER_FAILURES=0
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
# Optional allowlist for alert webhooks / SMS gateways / push endpoints (hosts or .suffixes, comma-separated).
EGRESS_ALLOWED_HOSTS=
# A refresh token presented again within this many seconds of its rotation is honoured (two tabs).
REFRESH_REUSE_GRACE_SECONDS=30

# P0.1: production and staging refuse to boot without METRICS_TOKEN (GET /metrics would be public otherwise).
METRICS_TOKEN=
# Largest accepted request body (bytes); candle arrays for backtests/scans are the big ones. Default 8 MB.
MAX_REQUEST_BODY_BYTES=8388608

# --- Platform mailer + email verification (Phase N3) --------------------------------------
# The platform's own SMTP account for account emails (verification links; password resets when the
# tenant has no EMAIL alert channel). Unset = links are written to the API log instead.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=
# true: LIVE deployments and broker credential storage need a verified email (needs the mailer).
EMAIL_VERIFICATION_REQUIRED=false
# Set to 1 only for a deliberate schema migration during NSE hours (scripts/migrate_guard.py).
MIGRATION_FORCE=

# --- Least-privilege database roles (Phase O1) -----------------------------------------------
# After `python scripts/init_db_roles.py`: the app connects as atp_app (DML only) and migrations
# run as atp_migrator (schema owner). Unset MIGRATION_DATABASE_URL = same URL as the app.
MIGRATION_DATABASE_URL=

# --- Web Push (Phase O3) ----------------------------------------------------------------------
# Generate once: `python -m app.alerts.webpush`. Rotating the key invalidates every browser subscription.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Billing gateway (Phase K1b) -------------------------------------------------------------
# manual (default): the operator records bank/UPI payments from the admin console.
# razorpay: Razorpay Subscriptions with hosted checkout + webhooks. Create the keys in the Razorpay
# dashboard (Settings -> API keys) and a webhook pointing at https://<api-host>/api/billing/webhooks/razorpay
# with the events subscription.charged, subscription.activated, subscription.halted,
# subscription.cancelled, subscription.completed, payment.failed; paste its secret below.
# These are the operator's platform secrets, not tenant data - never put a customer's keys here.
BILLING_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase AX: production overlay (docker-compose.prod.yml). DOMAIN gets an automatic Let's Encrypt
# certificate from Caddy; ACME_EMAIL receives its expiry notices. The OFFSITE_* values are the
# object-store (DigitalOcean Spaces / any S3) credentials for the hourly off-site copy of the
# backups and WAL archive - operator secrets, like everything else in this file.
DOMAIN=
ACME_EMAIL=
OFFSITE_REMOTE=spaces:atp-backups
OFFSITE_S3_ENDPOINT=blr1.digitaloceanspaces.com
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_INTERVAL_SECONDS=3600

# Phase BB: how long unverified news-feed rows are kept (manual cited entries are never deleted).
RETENTION_NEWS_FEED_DAYS=365
# P0.8: how long expired, never adopted AI strategist/interview candidates are kept (adopted/deployed rows stay).
RETENTION_AI_CANDIDATES_DAYS=30

# P0.8-C: AI models per tier (the model a tenant types under Settings replaces the strong one for that tenant only),
# pricing and the plan budgets. Keys never go here - they are entered under Settings and stored encrypted.
AI_ANTHROPIC_STRONG_MODEL=claude-opus-5-5
AI_ANTHROPIC_FAST_MODEL=claude-sonnet-5-5
# P0.10: the cheap tier - news classification and scanner reads (frequent, short) run on the smallest model.
AI_ANTHROPIC_CHEAP_MODEL=claude-haiku-5-5
AI_OPENAI_STRONG_MODEL=gpt-4.1
AI_OPENAI_FAST_MODEL=gpt-4.1-mini
AI_OPENAI_CHEAP_MODEL=gpt-4.1-nano
AI_USD_INR_RATE=84
# AI_MODEL_PRICES_JSON={"claude-opus-5-5": [4, 20, 0.2]}   # USD per million tokens: input, output, cache read
AI_BUDGET_INR_PRO=1500
AI_BUDGET_INR_BUSINESS=10000
AI_TIMEOUT_PER_1K_SECONDS=8

# Phase BC: market sentiment. Weights override (JSON, keys pcr/vix/breadth/global/fii_dii); FII_DII_SOURCE
# stays empty until a source whose terms allow automated use is configured (docs/DATA_SOURCES.md).
SENTIMENT_WEIGHTS=
FII_DII_SOURCE=

