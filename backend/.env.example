# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string (SQLAlchemy async URL, asyncpg driver).
# Local dev default matches: createuser atp_user, createdb -O atp_user advance_trading_platform
DATABASE_URL=postgresql+asyncpg://atp_user:atp_dev_password@localhost:5432/advance_trading_platform

# JWT signing secret for user auth tokens. Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key encrypting broker credentials at rest. MUST be set (and kept stable - rotating it
# makes previously-stored credentials undecryptable) in any real deployment, ideally sourced
# from a secret manager rather than this file. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Optional: caches short-lived, pure-computation results (option chain analysis, S/R zones).
# The API works fine without Redis reachable - every cache call fails open to a plain recompute.
REDIS_URL=redis://localhost:6379/0
