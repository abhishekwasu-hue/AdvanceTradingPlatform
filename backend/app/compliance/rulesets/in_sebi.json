{
  "id": "IN-SEBI",
  "jurisdiction": "IN",
  "version": "1",
  "effective_from": "2025-08-01",
  "source_note": "SEBI circular on safer participation of retail investors in algorithmic trading (Feb 2025, in force Aug 2025) and the NSE implementation standards; broker policies where the exchange leaves a choice. Parameters are config: change them here, never in code.",
  "rules": [
    {
