# Copy to .env (same directory as docker-compose.yml) and adjust before `docker compose up`.
# Never commit the real .env file.

POSTGRES_USER=atp_user
POSTGRES_PASSWORD=atp_dev_password
POSTGRES_DB=advance_trading_platform

# JWT signing secret. Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key encrypting broker credentials at rest. Leave unset only for local/dev - set (and
# keep stable, ideally via a secret manager) for anything real:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
