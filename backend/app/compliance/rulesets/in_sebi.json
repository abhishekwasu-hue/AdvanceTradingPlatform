        "app/brokers/upstox.py"
      ],
      "tests": [
        "tests/test_trade_port_order_safety.py::test_upstox_sends_market_protection_only_when_the_operator_sets_it"
      ],
      "flag": "LIVE_MARKET_PROTECTION"
    },
    {
      "id": "IN-SEBI.order_type.policy",
      "title": "Per-broker order-type policy for algo entries: MARKET allowed, mapped to a marketable LIMIT, or refused; validities allowed",
      "source": "SEBI retail-algo circular; broker policies",
      "status": "enforced",
      "params": {
        "default": {
          "market_for_algo": "allow",
          "allowed_validity": [
            "DAY",
            "IOC"
          ]
        },
        "brokers": {}
      },
      "code": [
        "app/compliance/order_policy.py",
        "app/execution/router.py"
      ],
      "tests": [
        "tests/test_d3_order_policy.py::test_default_policy_changes_nothing",
        "tests/test_d3_order_policy.py::test_market_entry_mapped_to_a_marketable_limit_for_one_broker",
        "tests/test_d3_order_policy.py::test_refused_market_or_validity_never_reaches_the_broker",
        "tests/test_d3_order_policy.py::test_exits_and_stops_are_not_touched_by_the_policy"
      ],
      "flag": null
