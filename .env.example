# Copy to .env (same directory as docker-compose.yml) and adjust before `docker compose up`.
# Never commit the real .env file.

POSTGRES_USER=atp_user
POSTGRES_PASSWORD=atp_dev_password
POSTGRES_DB=advance_trading_platform

# JWT signing secret. Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key encrypting broker credentials at rest. Leave unset only for local/dev - set (and
# keep stable, ideally via a secret manager) for anything real:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# The platform administrators' login emails, comma-separated (app/admin/bootstrap.py): they get the Admin Console
# (feature flags, invite codes) when they register or at the next API start. Needed once per host.
SUPER_ADMIN_EMAILS=

# P0.4: format for newly written secrets. "fernet" (default) is readable by every image since Phase N, so a
# rollback never strands a credential; set "aesgcm" (AES-256-GCM bound to tenant + column) once P0.4 has run
# for a day, then `python scripts/reencrypt_secrets.py reencrypt` to convert existing rows. Both are always read.
SECRETS_WRITE_FORMAT=fernet

# --- Phase G safety knobs (optional; defaults shown) ---------------------------------------
# Staleness gate: no signal when the newest base candle is more than this many bars behind the
# clock; no exit decision on a broker quote older than this many seconds (0 = off).
MARKET_DATA_MAX_STALE_BARS=3
QUOTE_MAX_STALE_SECONDS=120
# Phase S streaming quotes (Upstox Feed V3 / Kite ticker). Off: the worker polls REST once per
# symbol per cycle. On: ticks younger than TICK_MAX_AGE_SECONDS are used, REST otherwise.
STREAMING_QUOTES_ENABLED=false
# Part B2: write streamed ticks as 1-minute bars into the market data lake (needs STREAMING_QUOTES_ENABLED)
LAKE_TICK_WRITER_ENABLED=false
# Part B3: data-quality thresholds (events only)
LAKE_SPIKE_PCT=10
LAKE_LATE_SECONDS=300
LAKE_MISMATCH_PCT=0.5
# Part B4: also adjust prices for dividends in the adjusted view (splits and bonuses always are)
LAKE_ADJUST_DIVIDENDS=false
# Part B5: most bars one /api/market-data/history request returns
LAKE_HISTORY_MAX_BARS=5000
# HB0: R2 history import (docs/design/HB_HISTORY_BACKFILL.md). Run by hand only, behind the history_import flag.
# HISTORY_OWNER_TENANT_ID: the only tenant that receives the licensed 1-minute store; unset = 1-minute import refused.
HISTORY_OWNER_TENANT_ID=
# Must equal that tenant's name (a confirmation: a mistyped id is refused instead of loading another customer's tenant).
HISTORY_OWNER_TENANT_NAME=
# Most 1-minute rows one private-store history request reads before resampling (counted first).
LAKE_TENANT_MAX_BASE_ROWS=60000
# Bucket-scoped, read-only R2 token (S3 API). Fill on the server only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# HB1: daily NSE bhavcopy backfill + nightly EOD job (docs/design/HB_HISTORY_BACKFILL.md), only while the
# history_backfill flag is on. Polite fetching: one request at a time, paced, backoff on 429/403/5xx.
HISTORY_BACKFILL_PAUSE_SECONDS=1.5
HISTORY_BACKFILL_RETRIES=4
HISTORY_BACKFILL_MAX_BACKOFF_SECONDS=120
HISTORY_BACKFILL_USER_AGENT=
HISTORY_BACKFILL_SERIES=EQ,BE,BZ,SM,ST,SZ
HISTORY_BACKFILL_FO_OPTIONS=false
# F&O volume: withhold (stored as 0 until the CONTRACTS vs TtlTradgVol unit is confirmed) or as_printed
HISTORY_BACKFILL_FO_VOLUME=withhold
# Probe Saturdays / Sundays with the cash file (special sessions); false skips weekends
HISTORY_BACKFILL_PROBE_WEEKENDS=true
HISTORY_BACKFILL_MIN_ROWS_RATIO=0.5
# Optional: keep every downloaded file under this directory ({segment}/{yyyy}/{name}); empty = not kept.
HISTORY_BACKFILL_ARCHIVE_DIR=
HISTORY_BACKFILL_HOUR_IST=19
HISTORY_BACKFILL_CATCHUP_DAYS=7
# HB2: owner intraday history (docs/design/HB2_INTRADAY_HISTORY.md), only while the history_intraday flag is on.
# 1-minute bars from the OWNER's own broker session (HISTORY_OWNER_TENANT_ID above) into the owner's private store.
# Instruments: EXCHANGE:SYMBOL list (NSE / BSE) plus the owner tenant's deployments.
HISTORY_INTRADAY_SYMBOLS=
HISTORY_INTRADAY_INCLUDE_DEPLOYMENTS=true
HISTORY_INTRADAY_START=2022-01-03
HISTORY_INTRADAY_WINDOW_DAYS=7
# Off-hours only: from this IST hour (never before 15:45) until HISTORY_INTRADAY_STOP_HOUR_IST the next morning
HISTORY_INTRADAY_HOUR_IST=16
HISTORY_INTRADAY_STOP_HOUR_IST=8
HISTORY_INTRADAY_RETRY_MINUTES=15
HISTORY_INTRADAY_BUDGET_SECONDS=1800
# Share of the owner's broker rate budget left untouched for the trading worker (exits)
HISTORY_INTRADAY_RESERVE=0.5
# Most broker requests in any rolling 30 minutes, counted from the database (Upstox caps a user at 2,000 per 30 minutes)
HISTORY_INTRADAY_MAX_REQUESTS=600
# The one user whose own broker session HB2 reads (empty: the lowest-id active OWNER of the owner tenant)
HISTORY_OWNER_USER_ID=
# IST dates HB2 never calls the broker (special sessions: Muhurat, budget-day Saturday), comma-separated YYYY-MM-DD;
# a bad entry stops HB2 until fixed
HISTORY_INTRADAY_BLACKOUT_DATES=
# Part D7: refuse new F&O entries on an underlying in the exchange ban period (needs MWPL / OI rows in the lake)
FO_BAN_CHECK_ENABLED=false
TICK_MAX_AGE_SECONDS=120
# BT1: symbols one user's own broker session carries for the bring-your-own-broker data tier (flag byob_data_tier, off)
BYOB_SESSION_SYMBOL_CAP=50
# Trade port order-safety switches (off by default; LIVE behaviour unchanged until set).
# ORDER_MARKET_PROTECTION_PCT: 1-25 sends Upstox market_protection on MARKET / SL-M orders; empty = not sent.
ORDER_MARKET_PROTECTION_PCT=
# LIVE_STRICT_WING_FILL: true = a multi-leg entry sends its shorts only after every wing filled in full.
LIVE_STRICT_WING_FILL=false
# G-LIVE switches, all off until the operator decides (see docs/OPERATIONS.md "G-LIVE order switches"):
# LIVE_MARKET_PROTECTION: true = every Zerodha / Upstox MARKET and SL-M order carries market_protection
#   (ORDER_MARKET_PROTECTION_PCT when set, else -1 = the broker's automatic band).
LIVE_MARKET_PROTECTION=false
# LIVE_UPSTOX_OPTION_STOP_LIMIT: true = Upstox protective stops on options go as SL (stop-limit), not SL-M.
LIVE_UPSTOX_OPTION_STOP_LIMIT=false
# LIVE_EXIT_IF_NO_STOP: true = a LIVE position the broker clearly refused a stop for is closed at once.
LIVE_EXIT_IF_NO_STOP=false
# STOP_REARM_MAX_REJECTS: after this many re-armed stops in a row that the broker accepted and then rejected, the stop
# guard stops re-arming that position (with LIVE_EXIT_IF_NO_STOP it closes it; otherwise one CRITICAL alert).
STOP_REARM_MAX_REJECTS=3
# STOP_LIMIT_BAND_PCT: how far past the trigger a stop-limit's limit sits (% of the trigger, 0-20). Empty = today
# (1%, nearest tick); set (suggested 3 with the Upstox switch) = rounded outward, at least one tick past the trigger.
STOP_LIMIT_BAND_PCT=
# BACKTEST_HOLDOUT_START: e.g. 2026-04-01 - the optimizer never uses bars from this date on; empty = no sealed holdout.
BACKTEST_HOLDOUT_START=
# Phase AU global cues for the Copilot (US futures, Asia, Brent, gold, dollar, USD/INR, US 10Y) from
# free public data (Yahoo Finance, Stooq fallback), delayed ~15 min, background only - never a
# trading input. Needs outbound internet from the backend and worker; false turns the fetch off.
GLOBAL_CUES_ENABLED=true
# Per-broker circuit breaker: over FAILURE_RATIO of broker calls failing (timeouts/5xx/429) within
# WINDOW_SECONDS, after at least MIN_CALLS, pauses new LIVE entries to that broker platform-wide
# for OPEN_SECONDS. Exits are never paused.
BROKER_CIRCUIT_WINDOW_SECONDS=60
BROKER_CIRCUIT_MIN_CALLS=5
BROKER_CIRCUIT_FAILURE_RATIO=0.5
BROKER_CIRCUIT_OPEN_SECONDS=120

# P0.3: token signing and sessions.
# Issuer/audience claims on access tokens; previous secrets (comma-separated) still verify during a rotation;
# JWT_ACCEPT_LEGACY accepts pre-P0.3 tokens (no iss/aud) - set false a day after the deploy.
JWT_ISSUER=atp
JWT_AUDIENCE=atp-web
JWT_PREVIOUS_SECRET_KEYS=
JWT_ACCEPT_LEGACY=true
# Refresh token cookie name; REFRESH_TOKEN_IN_BODY=false once every browser runs the P0.3 UI.
REFRESH_COOKIE_NAME=atp_refresh
REFRESH_TOKEN_IN_BODY=true

# LD-7: API processes and each process's database pool (docs/PERFORMANCE.md "API processes"). Unset = the overlay's
# defaults: 1 process on a plain compose, 2 on the Hostinger KVM 2 (one per vCPU, pool 10 + overflow 5). Keep
# API_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + 30 (the two workers' pools) + room for backups under
# PG_MAX_CONNECTIONS (75 on the Hostinger overlay).
# API_WORKERS=2
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# bcrypt's threads run at nice +5 (0 = equal priority): a login wave yields CPU to the pages already open.
# BCRYPT_NICE=5

# P0.2: login protection and outbound URLs.
# Proxies whose X-Forwarded-For uvicorn trusts (the prod overlay sets "*": only Caddy reaches backend:8000).
FORWARDED_ALLOW_IPS=127.0.0.1
# redis = count request limits in Redis across replicas (automatic in production/staging); empty = in-process.
RATE_LIMIT_BACKEND=
# Progressive login delay after N failures per email (2^(n-N) s, capped); CAPTCHA after M failures when a provider is set.
LOGIN_DELAY_AFTER_FAILURES=3
LOGIN_DELAY_MAX_SECONDS=60
LOGIN_CAPTCHA_AFTER_FAILURES=0
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
# Optional allowlist for alert webhooks / SMS gateways / push endpoints (hosts or .suffixes, comma-separated).
EGRESS_ALLOWED_HOSTS=
# A refresh token presented again within this many seconds of its rotation is honoured (two tabs).
REFRESH_REUSE_GRACE_SECONDS=30

# P0.1: production and staging refuse to boot without METRICS_TOKEN (GET /metrics would be public otherwise).
METRICS_TOKEN=
# Largest accepted request body (bytes); candle arrays for backtests/scans are the big ones. Default 8 MB.
MAX_REQUEST_BODY_BYTES=8388608

# --- Platform mailer + email verification (Phase N3) --------------------------------------
# The platform's own SMTP account for account emails (verification links; password resets when the
# tenant has no EMAIL alert channel). Unset = links are written to the API log instead.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=
# true: LIVE deployments and broker credential storage need a verified email (needs the mailer).
EMAIL_VERIFICATION_REQUIRED=false
# Set to 1 only for a deliberate schema migration during NSE hours (scripts/migrate_guard.py).
MIGRATION_FORCE=

# --- Least-privilege database roles (Phase O1) -----------------------------------------------
# After `python scripts/init_db_roles.py`: the app connects as atp_app (DML only) and migrations
# run as atp_migrator (schema owner). Unset MIGRATION_DATABASE_URL = same URL as the app.
MIGRATION_DATABASE_URL=

# --- Web Push (Phase O3) ----------------------------------------------------------------------
# Generate once: `python -m app.alerts.webpush`. Rotating the key invalidates every browser subscription.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- The platform's Telegram bot ("Connect Telegram" in one tap) -----------------------------
# Create one bot with @BotFather and put its token here. Users then tap Connect Telegram and press Start; nobody types a
# token or a chat id. Unset = the Connect button says Telegram alerts are not set up yet. The username is read from
# Telegram when left blank. With a webhook secret set, register the webhook once from the admin route
# (POST /api/admin/telegram/platform/register); without it the app reads new messages while a user waits to connect.
ATP_TELEGRAM_BOT_TOKEN=
ATP_TELEGRAM_BOT_USERNAME=
ATP_TELEGRAM_WEBHOOK_SECRET=

# A2: server alerts to the platform operator (deploy/atp.sh ops-check, every 5 minutes). Telegram: link your chat in
# Admin > System > Alerts (one-time code with the platform bot above) - or put the chat id here. E-mail: through
# PLATFORM_SMTP_* to these addresses (comma-separated; empty = SUPER_ADMIN_EMAILS).
OPS_ALERT_TELEGRAM_CHAT_ID=
OPS_ALERT_EMAIL=
# A2: the error tracker - a GlitchTip or Sentry project's DSN. Empty = off (nothing is sent). Events are scrubbed of
# tokens, keys, e-mail addresses and phone numbers before they leave the server.
ERROR_TRACKER_DSN=

# --- Billing gateway (Phase K1b) -------------------------------------------------------------
# manual (default): the operator records bank/UPI payments from the admin console.
# razorpay: Razorpay Subscriptions with hosted checkout + webhooks. Create the keys in the Razorpay
# dashboard (Settings -> API keys) and a webhook pointing at https://<api-host>/api/billing/webhooks/razorpay
# with the events subscription.charged, subscription.activated, subscription.halted,
# subscription.cancelled, subscription.completed, payment.failed; paste its secret below.
# These are the operator's platform secrets, not tenant data - never put a customer's keys here.
BILLING_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google sign-in (GS-1, optional) -----------------------------------------------------------
# Both empty (the default): no "Continue with Google" button and the /api/auth/google/* routes answer 404.
# Create a Web application OAuth client in console.cloud.google.com (scopes openid, email, profile) with the
# authorised redirect URI https://<DOMAIN>/api/auth/google/callback (PUBLIC_BASE_URL + /api/auth/google/callback).
# Google sign-in never creates an account while the self_signup flag is off: it signs in the existing user whose
# e-mail equals the Google account's verified e-mail. The secret is never returned or logged.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Phase AX: production overlay (docker-compose.prod.yml). DOMAIN gets an automatic Let's Encrypt
# certificate from Caddy; ACME_EMAIL receives its expiry notices. The OFFSITE_* values are the
# object-store (DigitalOcean Spaces / any S3) credentials for the hourly off-site copy of the
# encrypted backups (never the WAL archive) - operator secrets, like everything else in this file.
DOMAIN=
ACME_EMAIL=
OFFSITE_REMOTE=spaces:atp-backups
OFFSITE_S3_ENDPOINT=blr1.digitaloceanspaces.com
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_INTERVAL_SECONDS=3600
# Z11 (deploy/atp.sh, docs/deploy/HOSTINGER_RUNBOOK.md) on the Hostinger host - set these in the server's .env:
#   BACKUP_ENCRYPTION_PASSPHRASE=   required: every dump and files archive is AES-256 encrypted with it (keep a copy off the server)
#   CADDYFILE=Caddyfile.ip          Caddyfile once DNS points at the server
#   OFFSITE_REMOTE=offsite:atp-backups  OFFSITE_S3_PROVIDER=Cloudflare  OFFSITE_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   OFFSITE_S3_ACCESS_KEY= OFFSITE_S3_SECRET_KEY=   the bucket-scoped R2 token (runbook section 6; keep both in escrow, 6a)
#   OFFSITE_LOCK_DAYS=14            the R2 bucket lock's retention days: nothing younger (+1 day) is ever deleted off-site
#   BACKUP_RETENTION_DAYS=7 BACKUP_KEEP_MIN=7 BACKUP_KEEP_WEEKLY=4 BACKUP_KEEP_MONTHLY=6   retention, here and on R2 (A1)
#   BACKUP_MAX_AGE_HOURS=26         health / backup-status fail when the last good backup (local or R2) is older
#   PG_ARCHIVE_MODE=                leave unset (off): WAL archiving and point-in-time recovery, runbook section 6c
#   COMPOSE_PROFILES=               optional services (research); atp.sh never adds one
#   BACKUP_EXTRA_DIRS=              optional host directories added to the encrypted files archive (space-separated)
#   ATP_DEPLOYMENT_PHASE=           leave unset: the host runs as phase0 (docker-compose.hostinger.yml, deploy/atp.sh) and
#                                   first boot seeds live_trading OFF + phase0_paper_only ON - nothing to set in Admin.
#                                   Any other value is the normal mode (no seed); only when the owner ends Phase 0.

# H-1: the worker warns the operators when Redis uses this share of its maxmemory (checked every N seconds);
# at the cap Redis evicts keys with a TTL, the worker lock among them (the worker then fails closed).
REDIS_MEMORY_WARN_RATIO=0.70
REDIS_MEMORY_CHECK_SECONDS=300

# Phase BB: how long unverified news-feed rows are kept (manual cited entries are never deleted).
RETENTION_NEWS_FEED_DAYS=365
# P0.8: how long expired, never adopted AI strategist/interview candidates are kept (adopted/deployed rows stay).
RETENTION_AI_CANDIDATES_DAYS=30

# P0.8-C: AI models per tier (the model a tenant types under Settings replaces the strong one for that tenant only),
# pricing and the plan budgets. Keys never go here - they are entered under Settings and stored encrypted.
AI_ANTHROPIC_STRONG_MODEL=claude-opus-5-5
AI_ANTHROPIC_FAST_MODEL=claude-sonnet-5-5
# P0.10: the cheap tier - news classification and scanner reads (frequent, short) run on the smallest model.
AI_ANTHROPIC_CHEAP_MODEL=claude-haiku-5-5
AI_OPENAI_STRONG_MODEL=gpt-4.1
AI_OPENAI_FAST_MODEL=gpt-4.1-mini
AI_OPENAI_CHEAP_MODEL=gpt-4.1-nano
AI_USD_INR_RATE=84
# AI_MODEL_PRICES_JSON={"claude-opus-5-5": [4, 20, 0.2]}   # USD per million tokens: input, output, cache read
AI_BUDGET_INR_PRO=1500
AI_BUDGET_INR_BUSINESS=10000
AI_TIMEOUT_PER_1K_SECONDS=8

# Phase BC: market sentiment. Weights override (JSON, keys pcr/vix/breadth/global/fii_dii); FII_DII_SOURCE
# stays empty until a source whose terms allow automated use is configured (docs/DATA_SOURCES.md).
SENTIMENT_WEIGHTS=
FII_DII_SOURCE=

# Backtests of NIFTY / BANKNIFTY options read expiries from the committed NSE file; a bar more than this many days
# after the file's last day is skipped and counted as "stale expiry data" (refresh with the 'NSE expiry data' workflow).
EXPIRY_DATA_STALE_GRACE_DAYS=10
# Part D2: SEBI orders-per-second throttle per client and exchange (exits first). Off by default; the rate is the
# IN-SEBI rule-set's ops_per_second unless OPS_PER_SECOND is set.
OPS_THROTTLE_ENABLED=false
OPS_PER_SECOND=

# Part D4: this server's public egress IP (deploy/hostinger/status.sh prints it) and whether LIVE entries need it
# registered for the deployment's broker (Settings > Static IP). Off by default.
SERVER_EGRESS_IP=
STATIC_IP_REQUIRED_FOR_LIVE=false
# Backtests of NIFTY / BANKNIFTY options read expiries from the committed NSE file; a bar more than this many days
# after the file's last day is skipped and counted as "stale expiry data" (refresh with the 'NSE expiry data' workflow).
EXPIRY_DATA_STALE_GRACE_DAYS=10
# Tax report: F&O turnover method. ABS_PNL (default) = sum of absolute profit/loss per trade; ABS_PNL_PLUS_PREMIUM =
# the older method that also adds premium received on options sold. The report names the method it used.
TAX_FNO_TURNOVER_METHOD=ABS_PNL
