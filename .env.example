# Copy to .env (same directory as docker-compose.yml) and adjust before `docker compose up`.
# Never commit the real .env file.

POSTGRES_USER=atp_user
POSTGRES_PASSWORD=atp_dev_password
POSTGRES_DB=advance_trading_platform

# JWT signing secret. Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key encrypting broker credentials at rest. Leave unset only for local/dev - set (and
# keep stable, ideally via a secret manager) for anything real:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Phase G safety knobs (optional; defaults shown) ---------------------------------------
# Staleness gate: no signal when the newest base candle is more than this many bars behind the
# clock; no exit decision on a broker quote older than this many seconds (0 = off).
MARKET_DATA_MAX_STALE_BARS=3
QUOTE_MAX_STALE_SECONDS=120
# Per-broker circuit breaker: over FAILURE_RATIO of broker calls failing (timeouts/5xx/429) within
# WINDOW_SECONDS, after at least MIN_CALLS, pauses new LIVE entries to that broker platform-wide
# for OPEN_SECONDS. Exits are never paused.
BROKER_CIRCUIT_WINDOW_SECONDS=60
BROKER_CIRCUIT_MIN_CALLS=5
BROKER_CIRCUIT_FAILURE_RATIO=0.5
BROKER_CIRCUIT_OPEN_SECONDS=120
