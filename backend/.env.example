# Copy to .env and fill in real values. Never commit the real .env file.

# "development" (default) skips the startup security checks below, so the app runs with zero
# config for local dev. Set to "production" in any real deployment - the app will then refuse to
# start if JWT_SECRET_KEY/SECRETS_ENCRYPTION_KEY are still unset/default or ALLOWED_ORIGINS is "*".
ENVIRONMENT=development

# PostgreSQL connection string (SQLAlchemy async URL, asyncpg driver).
# Local dev default matches: createuser atp_user, createdb -O atp_user advance_trading_platform
DATABASE_URL=postgresql+asyncpg://atp_user:atp_dev_password@localhost:5432/advance_trading_platform

# JWT signing secret for user auth tokens. Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Session lifetimes. Access tokens are short (minutes); the rotating refresh token keeps the
# browser logged in for this many days of inactivity at most.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Fernet key encrypting broker credentials at rest. MUST be set (and kept stable - rotating it
# makes previously-stored credentials undecryptable) in any real deployment, ideally sourced
# from a secret manager rather than this file. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Optional: caches short-lived, pure-computation results (option chain analysis, S/R zones).
# The API works fine without Redis reachable - every cache call fails open to a plain recompute.
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed frontend origins for CORS, e.g.
# "https://app.example.com,https://www.example.com". Defaults to "*" (any origin) for zero-config
# local dev. MUST be set to your real frontend domain(s) when ENVIRONMENT=production.
ALLOWED_ORIGINS=*

# Browser redirect target after a broker OAuth login (Upstox "Login to Upstox" button). "/" is
# right for docker-compose (same origin). For local dev with Vite: http://localhost:5173
FRONTEND_URL=/

# Platform administrators (SUPER_ADMIN), comma-separated emails. They see the Admin console:
# every tenant, plan/status changes, the platform audit trail and the global kill switch.
SUPER_ADMIN_EMAILS=

# Autonomous trading worker cadence (seconds between evaluation cycles). Default 60.
WORKER_CYCLE_SECONDS=60

# Phase D1: refuse LIVE orders until the organisation has entered its exchange-issued algo id
# (Team tab). Turn on once live trading is offered to customers.
ALGO_ID_REQUIRED_FOR_LIVE=false

# Phase D3: data retention (days). Run daily by the worker outside market hours. Only
# operational/personal rows are covered; orders, trades, signals and audit logs are never
# deleted (SEBI five-year rule). Values below 7 are raised to 7.
RETENTION_ENABLED=true
RETENTION_LOGIN_EVENTS_DAYS=365
RETENTION_ALERT_DELIVERIES_DAYS=90
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_SESSIONS_DAYS=30
RETENTION_PASSWORD_RESETS_DAYS=7
RETENTION_INVITES_DAYS=30

# Phase E1: observability. Bearer token Prometheus must send to scrape GET /metrics on the API
# (empty = unauthenticated, acceptable only on a private network); the worker serves its own
# /metrics on this port (0 = off).
METRICS_TOKEN=
WORKER_METRICS_PORT=9102
