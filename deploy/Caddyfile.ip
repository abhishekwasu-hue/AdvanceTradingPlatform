# The public edge before a domain exists (docker-compose.hostinger.yml, CADDYFILE=Caddyfile.ip): the server's own IP
# over HTTPS with Caddy's internal CA (self-signed - the browser warns once; Let's Encrypt does not issue for bare
# IPs). The refresh cookie is Secure, so plain HTTP would break login - port 80 only redirects. Same routes and
# headers as deploy/Caddyfile; switch to it (CADDYFILE=Caddyfile, DOMAIN=<name>) once DNS points here.
{
	default_sni {$DOMAIN}
}

http://{$DOMAIN} {
	redir https://{host}{uri} permanent
}

https://{$DOMAIN} {
	tls internal
	encode zstd gzip

	# Prometheus scrapes the API's /metrics from inside the host, never through the internet.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	handle /api/* {
		# P0.1 / S3: the API caps declared bodies itself (MAX_REQUEST_BODY_BYTES); the edge caps chunked ones too.
		request_body {
			max_size 8MB
		}
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# P0.3 / S6: same policy the frontend image sets (defence in depth at the edge).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}
