      "status": "enforced",
      "params": {},
      "code": [
        "app/compliance/algo_id.py",
        "app/execution/router.py",
        "app/execution/signal_execution.py"
      ],
      "tests": [
        "tests/test_algo_tagging.py::test_live_refused_without_algo_id_when_required"
      ],
      "flag": "ALGO_ID_REQUIRED_FOR_LIVE"
    },
    {
      "id": "IN-SEBI.algo_id.registered_above_ops",
      "title": "Above the OPS threshold the registered algo id is required (below it the broker's generic id)",
      "source": "SEBI retail-algo circular (OPS threshold set by the exchange)",
      "status": "enforced",
      "params": {
        "ops_threshold": 10,
        "generic_ids": {}
      },
      "code": [
        "app/compliance/algo_id.py",
        "app/execution/signal_execution.py"
      ],
      "tests": [
        "tests/test_d1_algo_id.py::test_registered_id_wins_generic_only_under_an_enforced_threshold",
        "tests/test_d1_algo_id.py::test_live_refused_without_a_usable_id_and_generic_id_goes_through"
      ],
      "flag": "ALGO_ID_REQUIRED_FOR_LIVE"
    },
    {
      "id": "IN-SEBI.ops.throttle",
      "title": "Orders per second per client, exchange and segment - modify, cancel and stop included; exits served first",
      "source": "SEBI retail-algo circular; ADR-0004 (exits never blocked)",
      "status": "enforced",
      "params": {
        "ops_per_second": 10,
        "counts": [
          "place",
          "modify",
          "cancel",
          "stop"
        ],
        "exit_lane_first": true,
        "backoff_seconds": [
          0.5,
          1,
          2,
          4
        ],
        "critical_after_429s": 3
      },
      "code": [
        "app/execution/ops_throttle.py",
        "app/brokers/rate_budget.py",
        "app/workers/trading_worker.py"
      ],
      "tests": [
        "tests/test_d2_ops_throttle.py::test_entries_beyond_the_rate_are_refused_before_the_broker_and_exits_are_never_refused",
        "tests/test_d2_ops_throttle.py::test_while_an_exit_waits_no_entry_takes_a_token",
        "tests/test_d2_ops_throttle.py::test_each_exchange_has_its_own_bucket",
        "tests/test_d2_ops_throttle.py::test_a_broker_429_pauses_that_exchange_and_a_success_resets_the_back_off"
      ],
      "flag": "OPS_THROTTLE_ENABLED"
    },
    {
      "id": "IN-SEBI.api.rate_budget",
      "title": "Per-tenant broker API budget (requests per second and minute) on every call",
      "source": "broker API limits",
      "status": "enforced",
      "params": {},
      "code": [
        "app/brokers/rate_budget.py"
      ],
      "tests": [
        "tests/test_rate_budget.py::test_rate_limited_broker_delegates_every_call_through_the_budget",
        "tests/test_rate_budget.py::test_worker_wraps_each_tenant_adapter_in_its_own_budget"
      ],
      "flag": null
    },
    {
      "id": "IN-SEBI.order_type.market_protection",
      "title": "Market and SL-M orders carry market protection where the broker requires it",
      "source": "exchange rule for algo orders; Kite / Upstox APIs",
      "status": "enforced",
      "params": {},
      "code": [
        "app/execution/order_safety.py",
