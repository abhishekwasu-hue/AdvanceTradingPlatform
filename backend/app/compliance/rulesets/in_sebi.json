    {
      "id": "IN-SEBI.login.daily",
      "title": "Daily 2FA / OAuth login per broker session; no reliance on refresh tokens; pre-open reminder",
      "source": "SEBI retail-algo circular; broker session rules",
      "status": "enforced",
      "params": {
